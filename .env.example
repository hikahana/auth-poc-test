# Firebase Admin SDK service account key (Firebaseコンソール > プロジェクト設定 >
# サービスアカウント > 新しい秘密鍵の生成、でダウンロードしたJSON)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Googleログインボタンが使うOAuthクライアントID（Google Cloudコンソール > APIとサービス > 認証情報 の
# 「Web client (auto created by Google Service)」）。web/firebase-config.js の googleClientId と同じ値にする
GOOGLE_OAUTH_CLIENT_ID=XXXXXXXXXXXX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# 省略可（デフォルト値はconfig.Loadを参照）
# AUTH_PLATFORM_ADDR=:8080
# AUTH_PLATFORM_DB_PATH=auth-platform.db
