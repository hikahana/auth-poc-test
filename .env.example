# Firebase Admin SDK service account key (Firebaseコンソール > プロジェクト設定 >
# サービスアカウント > 新しい秘密鍵の生成、でダウンロードしたJSON)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# 名簿（ホワイトリスト）を管理できる人のメールアドレス。カンマ区切りで複数可。
# この人がGoogleでログインしていれば、名簿の登録・削除ができる。
AUTH_PLATFORM_ADMIN_EMAILS=you@example.com

# 省略可（デフォルト値はconfig.Loadを参照）
# AUTH_PLATFORM_ADDR=:8080
# AUTH_PLATFORM_DB_PATH=auth-platform.db
